@startuml
left to right direction
actor User

rectangle "DFA Studio" {
  usecase "Create DFA" as UC1
  usecase "Manage states and alphabet" as UC2
  usecase "Select initial state" as UC3
  usecase "Mark accepting states" as UC4
  usecase "Define transitions" as UC5
  usecase "View transition table" as UC6
  usecase "Validate DFA" as UC7
  usecase "Enter input string" as UC8
  usecase "Run simulation" as UC9
  usecase "View execution trace" as UC10
  usecase "View acceptance result" as UC11
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10
User --> UC11

UC9 .> UC7 : <<include>>
UC9 .> UC10 : <<include>>
UC9 .> UC11 : <<include>>
@enduml
